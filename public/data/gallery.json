      "connectors": ["SharePoint", "Microsoft 365", "Outlook"],
      "stages": 3,
      "accent": "#3FB950",
      "desc": "Reads the request category and automatically routes it to the right support team. Eliminated manual ticket assignment — IT support team now gets instant notifications."
    },
    {
      "name": "HR Staff Requisition — Multi-Level Approval",
      "phase": "5.7",
      "dept": "HR",
