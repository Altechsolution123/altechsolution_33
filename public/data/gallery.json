      "connectors": ["SharePoint", "Approvals", "Outlook"],
      "stages": 5,
      "accent": "#BC8CFF",
      "desc": "Routes hiring requests through 5 levels of management approval — department head → division head → HR → COO → Executive Director. Each approver gets an email with one-click Approve/Reject."
    },
    {
      "name": "Purchase Requisition — Buyer Assignment",
      "phase": "5.5",
      "dept": "Procurement",
      "formCodes": ["PRF"],
      "trigger": "When a purchase request is submitted",
      "connectors": ["SharePoint", "Outlook"],
      "stages": 4,
      "accent": "#FFA657",
      "desc": "Automatically assigns purchase requests to the correct procurement buyer. Replaced a manual process that took days — now buyers are notified within minutes."
    },
    {
      "name": "Change Request — Full Approval Chain",
      "phase": "5.6",
      "dept": "Quality",
      "formCodes": ["SAPCR"],
      "trigger": "When a change request is submitted",
      "connectors": ["SharePoint", "Approvals", "Outlook"],
      "stages": 7,
      "accent": "#F85149",
      "desc": "Most complex workflow — 7-stage approval chain for supplier and workbench change requests. Tracks every stage with deadline alerts so nothing falls through the cracks."
