      "stages": 5,
      "accent": "#58A6FF",
      "desc": "5-stage security approval for VPN and remote access requests. Ensures every access grant goes through proper IT security review before provisioning."
    },
    {
      "name": "Hardware Inventory — Monthly Audit Reminder",
      "phase": "5.4",
      "dept": "IT",
      "formCodes": ["HI"],
      "trigger": "Runs automatically every month",
      "connectors": ["SharePoint", "Outlook"],
      "stages": 2,
      "accent": "#D29922",
      "desc": "Scheduled monthly reminders for hardware inventory audits. Replaced a manual calendar task — automated emails with escalating urgency if audits aren't completed on time."
